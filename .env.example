# Copy this file to .env and fill in the values for local development.
TRACEFIX_API_KEY=
# DeepSeek-compatible Chat Completions endpoint; omit /chat/completions.
TRACEFIX_BASE_URL=https://api.deepseek.com
TRACEFIX_TEXT_MODEL=deepseek-chat
# 配置 Brave Search API key 后启用 WebSearch；留空时不注册搜索工具。
TRACEFIX_WEB_SEARCH_API_KEY=
# DeepSeek 默认开启 thinking；其他兼容端点仅在显式配置时发送该字段。返回的 reasoning 会进入调用审计。
TRACEFIX_THINKING=enabled
# 修复模式：hybrid（默认，外层门禁 + 内层 Agent 循环）或 pipeline（阶段流水线）。
# 不满足条件时 Run 自动回退为 pipeline，并在报告中记录 repair_mode_reason。
TRACEFIX_REPAIR_MODE=hybrid
# 示例配置使用非流式响应；设为 true 时可分别接收正文和 reasoning 增量。
TRACEFIX_STREAM=false
TRACEFIX_MODEL_TIMEOUT=240
# 默认不向模型发送截图；仅在确认模型支持图像后填写视觉模型名称。
TRACEFIX_VISION_MODEL=
# Worker 默认复用 Supervisor；只有非空覆盖才创建独立 Gateway，未覆盖项继续继承。
TRACEFIX_WORKER_BASE_URL=
TRACEFIX_WORKER_API_KEY=
TRACEFIX_WORKER_TEXT_MODEL=
# 独立 Worker Gateway 可显式留空此项以关闭图片；省略则继承 Supervisor 视觉模型。
TRACEFIX_WORKER_VISION_MODEL=
POSTGRES_PASSWORD=tracefix
TRACEFIX_DATABASE_URL=postgresql://tracefix:tracefix@127.0.0.1:55432/tracefix
TRACEFIX_INPUT_USD_PER_M=0
TRACEFIX_OUTPUT_USD_PER_M=0
TRACEFIX_GIT_AUTHOR_NAME=TraceFix
TRACEFIX_GIT_AUTHOR_EMAIL=tracefix@localhost
# Optional dense RAG. Set both values together and pin the revision.
TRACEFIX_EMBEDDING_URL=
TRACEFIX_EMBEDDING_REVISION=
LANGSMITH_TRACING=false
# GitHub MCP 官方 Docker stdio server 的只读凭据；不提交本地 .env。
TRACEFIX_GITHUB_TOKEN=

TRACEFIX_CODEGRAPH_ROOT=
TRACEFIX_CODEGRAPH_TIMEOUT=120
TRACEFIX_CODEGRAPH_COMMAND=
