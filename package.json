{
  "name": "tracefix",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*",
    "backend/apps/*",
    "backend/packages/console-service"
  ],
  "scripts": {
    "build": "npm run build --workspace @tracefix/console-service && npm run build --workspace @tracefix/cli && npm run build --workspace @tracefix/web",
    "typecheck": "npm run typecheck --workspace @tracefix/web",
    "test": "npm test --workspace @tracefix/console-service && npm test --workspace @tracefix/console-api",
    "dev": "npm run dev --workspace @tracefix/web",
    "start": "npm start --workspace @tracefix/console-api"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
