{
  "name": "@tracefix/console-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/dispatch.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "esbuild src/dispatch.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs",
    "test": "npm run build && npm run build --workspace @tracefix/cli && node --test test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
