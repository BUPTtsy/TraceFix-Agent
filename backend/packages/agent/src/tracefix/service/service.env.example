TRACEFIX_SERVICE_DATA_ROOT=/deployment/tracefix-beta-runtime/data
TRACEFIX_SERVICE_CONSOLE_DB=/deployment/tracefix-beta-runtime/console.sqlite3
TRACEFIX_SERVICE_DATABASE_URL=
TRACEFIX_SERVICE_GITHUB_CREDENTIAL_MAP={"deployment/alpha":"TRACEFIX_BETA_GITHUB_TOKEN"}
TRACEFIX_BETA_GITHUB_TOKEN=
TRACEFIX_API_KEY=
TRACEFIX_BASE_URL=https://api.openai.com/v1
TRACEFIX_TEXT_MODEL=
TRACEFIX_VISION_MODEL=
# 服务进程执行 repair 时，编码一律交给 Docker 内的 Claude Agent SDK worker，没有其他编码路径；含义同根目录 .env.example。
# repair 必填：模型、凭据、worker 镜像完整 ID、受控出口网络与代理。网关与 TRACEFIX_BASE_URL 同源时可复用 TRACEFIX_API_KEY / TRACEFIX_TEXT_MODEL。
TRACEFIX_CLAUDE_BASE_URL=
TRACEFIX_CLAUDE_API_KEY=
TRACEFIX_CLAUDE_CREDENTIAL_REF=
TRACEFIX_CLAUDE_MODEL=
TRACEFIX_SDK_WORKER_IMAGE=
TRACEFIX_SDK_NETWORK=
TRACEFIX_SDK_EGRESS_PROXY=
TRACEFIX_SDK_EGRESS_ALLOWLIST=
TRACEFIX_SDK_STOP_GRACE_SECONDS=
TRACEFIX_SDK_SESSION_TIMEOUT_SECONDS=
